<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="SettingsMenu" src="project://database/Assets/UI%20Toolkit/SettingsMenu.uxml?fileID=9197481963319205126&amp;guid=774d38d636bfb324eab883249e6c0099&amp;type=3#SettingsMenu" />
    <Style src="project://database/Assets/UI%20Toolkit/Menu.uss?fileID=7433441132597879392&amp;guid=11ac15a71fcec9a46a277054ddd917f6&amp;type=3#Menu" />
    <engine:VisualElement style="flex-grow: 1;">
        <engine:VisualElement name="PauseMenuRoot" style="flex-grow: 1; flex-direction: column; position: absolute; width: 100%; height: 100%;">
            <engine:Label text="Paused" name="Paused" style="-unity-text-align: middle-center; position: relative; font-size: 64px; margin-top: 124px; margin-right: 21px; margin-bottom: 21px; margin-left: 21px; color: rgb(143, 35, 55);" />
            <engine:Button text="Resume" name="ResumeButton" style="width: 128px; height: 32px; align-self: center; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;); font-size: 16px;" />
            <engine:Button text="Settings" name="SettingsButton" style="width: 128px; height: 32px; align-self: center; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;); font-size: 16px;" />
            <engine:Button text="Main Menu" name="MainMenuButton" style="width: 128px; height: 32px; align-self: center; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;); font-size: 16px;" />
        </engine:VisualElement>
        <engine:VisualElement name="SettingsMenuRoot" enabled="false" class="right" style="flex-grow: 1; width: 100%; height: 100%; position: absolute;">
            <engine:Instance template="SettingsMenu" />
            <engine:Button text="Back" name="BackButton" style="position: absolute; width: 221px; height: 27px; top: 410px; left: 298px; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;);" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
