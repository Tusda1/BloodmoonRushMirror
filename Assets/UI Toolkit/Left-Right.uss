.menu {
    position: absolute;
    width: 100%;
    height: 100%;
    transition: all 1s;
    transition-timing-function: ease-out-elastic;
    transition-duration: 2s;
    transition-property: translate;
}

.left {
    translate: -100% 0;
}

.right {
    translate: 100% 0;
}

.down {
    translate: 0 100%;
}

.up {
    translate: 0 100%;
}
