DropdownField {
}

DropdownField :focus {
}

DropdownField .unity-label {
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-104513264&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_8");
    width: 156px;
    max-width: 156px;
    min-width: 156px;
    height: 34px;
    max-height: 34px;
    min-height: 34px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 9px;
    padding-right: 9px;
    padding-bottom: 9px;
    padding-left: 9px;
}

DropdownField .unity-base-field__input {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-342890214&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_7");
    width: 250px;
    max-width: 250px;
    min-width: 250px;
    height: 34px;
    max-height: 34px;
    min-height: 34px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

DropdownField .unity-base-popup-field__text {
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 6px;
    font-size: 16px;
    -unity-font-definition: resource('Fonts/NPCUi');
    color: rgb(255, 255, 255);
}

DropdownField .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-621971046&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_23");
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
}

DropdownField :focus .unity-base-popup-field__arrow {
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-1567709295&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_24");
}

DropdownField :hover .unity-base-popup-field__arrow {
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-1567709295&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_24");
}

.unity-base-dropdown {
    width: 251px;
    max-width: 251px;
    min-width: 251px;
}

.unity-base-dropdown__container-outer {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet%201.png?fileID=-1905917487&guid=90730bc22eee8c54b8f64bb5acb0c2a2&type=3#UI_Asset_Sheet 1_46");
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    width: 251px;
    max-width: 251px;
    min-width: 251px;
    height: 146px;
    max-height: 146px;
    min-height: 146px;
}

.unity-base-dropdown__container-inner {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.unity-base-dropdown__item {
    -unity-font-definition: resource('Fonts/NPCUi');
    font-size: 16px;
    color: rgb(255, 255, 255);
    width: 100%;
    height: 27px;
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#unity-content-container {
    align-items: flex-start;
    flex-direction: column;
    flex-wrap: nowrap;
}

.unity-base-dropdown__item-content {
    -unity-font-definition: resource('Fonts/NPCUi');
    font-size: 16px;
    color: rgb(255, 255, 255);
    width: 100%;
}
