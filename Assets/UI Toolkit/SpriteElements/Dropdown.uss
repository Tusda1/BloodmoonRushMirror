DropdownField {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

DropdownField :focus {
}

DropdownField .unity-label {
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=1056339500&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_6");
    width: 135px;
    max-width: 135px;
    min-width: 135px;
    height: 34px;
    max-height: 34px;
    min-height: 34px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 9px;
    padding-right: 9px;
    padding-bottom: 9px;
    padding-left: 9px;
    -unity-text-align: upper-center;
}

DropdownField .unity-base-field__input {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=-323035723&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_16");
    width: 235px;
    max-width: 235px;
    min-width: 235px;
    height: 34px;
    max-height: 34px;
    min-height: 34px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-font-definition: resource('Fonts/UI');
}

DropdownField .unity-base-popup-field__text {
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 6px;
    font-size: 16px;
    -unity-font-definition: resource('Fonts/UI');
    color: rgb(255, 255, 255);
}

DropdownField .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=1422604218&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_3");
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
}

DropdownField :focus .unity-base-popup-field__arrow {
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=1074649559&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_2");
}

DropdownField :hover .unity-base-popup-field__arrow {
    width: 47px;
    max-width: 47px;
    min-width: 47px;
    height: 21px;
    max-height: 21px;
    min-height: 21px;
    right: 5px;
    bottom: 1px;
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=1074649559&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_2");
}

.unity-base-dropdown {
    width: 251px;
    max-width: 251px;
    min-width: 251px;
}

.unity-base-dropdown__container-outer {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    background-image: url("project://database/Assets/Art/SettingsMenu/Settings_Assets.png?fileID=884728798&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_13");
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    width: 235px;
    max-width: 235px;
    min-width: 235px;
    height: 146px;
    max-height: 146px;
    min-height: 146px;
}

.unity-base-dropdown__container-inner {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.unity-base-dropdown__item {
    width: 100%;
    height: 27px;
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(153, 153, 153, 0);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(100, 49, 60);
}

.unity-base-dropdown__item:hover:enabled {
    background-color: rgb(100, 49, 60);
}

#unity-content-container {
    align-items: flex-start;
    flex-direction: column;
    flex-wrap: nowrap;
}

.unity-base-dropdown__item-content {
    -unity-font-definition: resource('Fonts/NPCUi');
    font-size: 16px;
    color: rgb(255, 255, 255);
    width: 100%;
}
