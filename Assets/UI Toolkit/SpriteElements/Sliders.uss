Slider {
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=-1157797732&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_21");
    width: 586px;
    height: 28px;
    max-width: 586px;
    min-width: 586px;
    max-height: 28px;
    min-height: 28px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-self: center;
}

#unity-drag-container {
    width: 586px;
    align-items: auto;
    justify-content: flex-start;
    align-self: flex-start;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    max-width: 586px;
    min-width: 586px;
    height: 0;
    max-height: 0;
    min-height: 0;
}

#unity-tracker {
    border-radius: 25px;
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=-1157797732&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_21");
    width: 586px;
    height: 28px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    max-height: 28px;
    min-height: 28px;
    max-width: 586px;
    min-width: 0;
}

#unity-fill {
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=2060259799&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_10");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: left 0;
}

#unity-dragger {
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=-1730127388&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_11");
    background-color: rgba(0, 0, 0, 0);
    cursor: url('project://database/Assets/UI/Textures/Cursors/Cursor_B.png?fileID=2800000&guid=f3c815d95da3a483385620d7bd8fc545&type=3#Cursor_B') 10 11;
    width: 14px;
    height: 40px;
    max-width: 14px;
    min-width: 14px;
    max-height: 40px;
    min-height: 40px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    top: -6px;
}

#unity-dragger-border {
    background-image: url("project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=-1166969415&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_12");
    background-color: rgb(255, 255, 255);
}
