.unity-slider {
    background-image: url('project://database/Assets/Art/UIArt/UI_Asset_Sheet.png?fileID=-1157797732&guid=fc3565351fa61854ebeb34f6159db6f4&type=3#UI_Asset_Sheet_21');
    width: 376px;
    height: 28px;
    max-width: 376px;
    min-width: 376px;
    max-height: 28px;
    min-height: 28px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-self: center;
}

#unity-drag-container {
    width: 376px;
    align-items: auto;
    justify-content: flex-start;
    align-self: flex-start;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    max-width: 376px;
    min-width: 376px;
    height: 0;
    max-height: 0;
    min-height: 0;
}

#unity-tracker {
    border-radius: 25px;
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=-1420628315&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_1");
    width: 376px;
    height: 28px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    max-height: 28px;
    min-height: 28px;
    max-width: 376px;
    min-width: 376px;
    background-color: rgba(0, 0, 0, 0);
}

#unity-fill {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=-1550425711&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_0");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: left 0;
}

#unity-dragger {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=2055428622&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_5");
    background-color: rgba(0, 0, 0, 0);
    cursor: url('project://database/Assets/UI/Textures/Cursors/Cursor_B.png?fileID=2800000&guid=f3c815d95da3a483385620d7bd8fc545&type=3#Cursor_B') 10 11;
    width: 16px;
    height: 42px;
    max-width: 16px;
    min-width: 16px;
    max-height: 42px;
    min-height: 42px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    top: -6px;
}

#unity-dragger-border {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=703130352&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_4");
    background-color: rgb(255, 255, 255);
}

#unity-dragger:hover {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=703130352&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_4");
    background-color: rgba(0, 0, 0, 0);
    cursor: url('center') 10 11;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    top: -6px;
}

.unity-slider:focus #unity-dragger {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=703130352&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_4");
    background-color: rgba(0, 0, 0, 0);
    cursor: url('center') 10 11;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    top: -6px;
}

#unity-drag-container:active #unity-dragger {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets_2.png?fileID=665808833&guid=3007733fb5d5c9c4a93c363cb534f7e2&type=3#Settings_Assets_2_0");
}
