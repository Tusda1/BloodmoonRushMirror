    padding-bottom: 0;
    padding-left: 0;
}

.unity-toggle__input {
    background-image: url("project://database/Assets/Art/UI/Settings_Assets.png?fileID=1997121673&guid=8669abad7bb91734b9c5d76592cafacc&type=3#Settings_Assets_9");
