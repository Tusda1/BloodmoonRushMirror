<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement data-source-type="UI.DialogueUI, Assembly-CSharp" style="flex-grow: 1; position: absolute; width: 800px; height: 70px; bottom: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Art/Ui_1.png?fileID=8556403123840757892&amp;guid=840c6115f04297444bc4fdcd18f5e8a5&amp;type=3#Ui_1_25&quot;);">
        <engine:Label text="David" style="position: absolute; top: 1px; left: 16px; height: 17px; width: 100px; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;); -unity-text-align: middle-center; font-size: 16px;">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="characterName" binding-mode="ToTarget" />
            </Bindings>
        </engine:Label>
        <engine:Label text="Label" style="position: absolute; top: 6px; left: 141px; height: 60px; width: 652px; -unity-font-definition: resource(&apos;Fonts/NPCUi&apos;); -unity-text-align: upper-left; font-size: 16px;">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="dialogueText" binding-mode="ToTarget" />
            </Bindings>
        </engine:Label>
        <engine:VisualElement style="flex-grow: 1; position: absolute; height: 74px; top: -75px; width: 74px; background-image: url(&quot;project://database/Assets/Art/Icons/Drucilla/drusilla%20laugh%20potrait.png?fileID=-1587205731444698363&amp;guid=5620f4f64f5a9cc40be14fa5fdcc6b54&amp;type=3#drusilla laugh potrait_0&quot;); left: 33px;" />
        <Bindings>
            <engine:DataBinding property="style.display" data-source-path="uiDocumentVisible" binding-mode="ToTarget" source-to-ui-converters="Bool To DisplayStyle" />
        </Bindings>
    </engine:VisualElement>
</engine:UXML>
