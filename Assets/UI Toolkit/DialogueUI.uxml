<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement data-source-type="UI.DialogueUI, Assembly-CSharp" data-source="project://database/Assets/DialogueSystem/DialogueUI_DataContainer.asset?fileID=11400000&amp;guid=207c2a36488570e4ebcd26dd738bd2c2&amp;type=2#DialogueUI_DataContainer" style="flex-grow: 1; position: absolute; width: 800px; height: 70px; bottom: 0; opacity: 1;">
        <UI_Toolkit.SpriteElement sprite="project://database/Assets/Art/PlayerUI/Player_Ui.png?fileID=1357641779&amp;guid=ab571c25ce68ab945ae98f3e0d68de72&amp;type=3#Player_Ui_7" style="position: absolute;" />
        <engine:Label text="Drucilla" style="position: absolute; top: 1px; left: 16px; height: 15px; width: 100px; -unity-text-align: middle-center; font-size: 16px;">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="characterName" binding-mode="ToTarget" />
                <engine:DataBinding property="style.unityFontDefinition" data-source-path="characterNameFontAsset" binding-mode="ToTarget" />
                <engine:DataBinding property="style.color" data-source-path="characterNameColor" binding-mode="ToTarget" />
            </Bindings>
        </engine:Label>
        <engine:Label text="Keep your eyes peeled! And don’t worry—I’ll check in from time to time. Think of this phone as your magical helpline. No fees, no long hold times—just pure wizardry, baby!" style="position: absolute; top: 3px; left: 140px; height: 63px; width: 497px; -unity-text-align: upper-left; font-size: 16px; white-space: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 2px; word-spacing: 2px;">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="text" binding-mode="ToTarget" />
                <engine:DataBinding property="style.unityFontDefinition" data-source-path="textFontAsset" binding-mode="ToTarget" />
                <engine:DataBinding property="style.fontSize" data-source-path="textSize" binding-mode="ToTarget" />
                <engine:DataBinding property="style.color" data-source-path="textColor" binding-mode="ToTarget" />
            </Bindings>
        </engine:Label>
        <engine:VisualElement style="width: 162px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Art/Portraits/David/David%20Portrait%20NUT.png?fileID=-431085107&amp;guid=a1873a41348d9734fa2d25bce4263306&amp;type=3#David Portrait NUT_0&quot;); max-height: 274px; background-position-y: bottom 0; background-position-x: center 0; height: 190px; top: -190px; left: 1px; position: absolute; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <UI_Toolkit.SkipDialogueButton_Animated name="WizardStatic" sprite="project://database/Assets/Art/Portraits/Oswald/ezgif-split/frame_00_delay-0.25s.png?fileID=-746634608713195320&amp;guid=0b7c261a71d28254c8fc49fd21a43f73&amp;type=3#frame_00_delay-0.25s_0" style="bottom: -19px;">
                <Bindings>
                    <engine:DataBinding property="style.opacity" data-source-path="staticSpriteOpacity" binding-mode="ToTarget" />
                </Bindings>
            </UI_Toolkit.SkipDialogueButton_Animated>
            <Bindings>
                <engine:DataBinding property="style.backgroundImage" data-source-path="characterPortrait" binding-mode="ToTarget" />
            </Bindings>
        </engine:VisualElement>
        <UI_Toolkit.SkipDialogueButton_Animated frames-per-second="20" sprite="project://database/Assets/Art/UIArt/Button-animation-sheet.png?fileID=872531804&amp;guid=f52bf8542b8b3194bbb75e12bbf3745c&amp;type=3#Button-animation-sheet_44" animation-frame1="project://database/Assets/Art/UIArt/Button-animation-sheet.png?fileID=872531804&amp;guid=f52bf8542b8b3194bbb75e12bbf3745c&amp;type=3#Button-animation-sheet_44" animation-frame2="project://database/Assets/Art/UIArt/Button-animation-sheet.png?fileID=1039468592&amp;guid=f52bf8542b8b3194bbb75e12bbf3745c&amp;type=3#Button-animation-sheet_45" animation-frame3="project://database/Assets/Art/UIArt/Button-animation-sheet.png?fileID=1161822980&amp;guid=f52bf8542b8b3194bbb75e12bbf3745c&amp;type=3#Button-animation-sheet_46" animation-frame4="project://database/Assets/Art/UIArt/Button-animation-sheet.png?fileID=1733767374&amp;guid=f52bf8542b8b3194bbb75e12bbf3745c&amp;type=3#Button-animation-sheet_47" begin-animation="true" delay-per-frame="0.2" name="SkipDialogueButton" style="position: absolute; top: 37px; left: 56px;" />
        <Bindings>
            <engine:DataBinding property="style.display" data-source-path="uiDocumentVisible" binding-mode="ToTarget" source-to-ui-converters="Bool To DisplayStyle" />
        </Bindings>
    </engine:VisualElement>
</engine:UXML>
