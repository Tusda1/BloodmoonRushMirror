.heartBar {
    flex-direction: row;
}

.davidLabel {
    -unity-font-definition: resource('Fonts/David');
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-left;
}

#x {
    top: -3px;
}
