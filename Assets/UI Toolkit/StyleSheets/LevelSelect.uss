Button {
    -unity-font-definition: resource('Fonts/UI');
    background-color: rgb(46, 34, 46);
    border-left-color: rgb(28, 22, 28);
    border-right-color: rgb(28, 22, 28);
    border-top-color: rgb(28, 22, 28);
    border-bottom-color: rgb(28, 22, 28);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    color: rgb(126, 126, 126);
}

Button:hover {
    color: rgb(209, 209, 209);
}

Button:focus {
    color: rgb(209, 209, 209);
}
