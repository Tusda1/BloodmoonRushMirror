.MenuHeader {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.Container {
    position: relative;
    align-items: center;
    align-content: center;
    justify-content: space-evenly;
    padding-top: 45px;
    padding-right: 5px;
    padding-bottom: 15px;
    padding-left: 5px;
}

Label {
    font-size: 16px;
    -unity-font-definition: resource('Fonts/NPCUi');
    color: rgb(255, 255, 255);
}
