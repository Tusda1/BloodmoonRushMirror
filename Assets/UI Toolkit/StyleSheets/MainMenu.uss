.heartBar {
    flex-direction: row;
}

.DavidUIText {
    -unity-font-definition: url('project://database/Assets/Fonts/David.ttf?fileID=12800000&guid=3a1bf8d7abe93284390d857df10dc795&type=3#David');
    font-size: 8px;
    position: absolute;
    color: rgb(255, 255, 255);
}

.opacity0 {
    opacity: 0;
}

.deathScreenButton {
    color: rgb(255, 255, 255);
}

.deathScreenButton:focus {
    color: rgb(173, 65, 74);
}

.deathScreenButton:hover {
    color: rgb(142, 52, 59);
}

.settingsText {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/NPCUi.asset?fileID=11400000&guid=3dec3d4e03028b44fad9f882eaa2ea45&type=2#NPCUi");
    font-size: 16px;
}

Label {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/NPCUi.asset?fileID=11400000&guid=3dec3d4e03028b44fad9f882eaa2ea45&type=2#NPCUi");
}

Button {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
