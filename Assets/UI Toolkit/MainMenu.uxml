    <engine:VisualElement style="flex-grow: 1; width: 100%; height: 100%;">
        <engine:Label text="Press Any Key" name="PressAnyKeyLabel" style="-unity-text-align: upper-center; font-size: 16px; color: rgb(255, 255, 255); top: 388px;" />
        <engine:Instance template="SettingsMenu" name="SettingsMenu" style="width: 100%; height: 100%;" />
        <engine:VisualElement name="MainMenu" class="down" style="flex-grow: 1; transition-duration: 1s; transition-property: all; width: 100%; height: 100%; position: absolute;">
            <engine:VisualElement name="MainMenuRoot" style="flex-grow: 1; flex-direction: row; justify-content: space-around; top: 325px; transition-duration: 1s; transition-property: all;">
                <engine:Instance template="StartButton" />
                <engine:Instance template="SettingsButton" />
                <engine:Instance template="QuitButton" />
