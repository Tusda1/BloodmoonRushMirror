    <engine:Template name="QuitButton" src="project://database/Assets/UI%20Toolkit/SpriteElements/QuitButton.uxml?fileID=9197481963319205126&amp;guid=dc2ece243e73d894387761be386e908f&amp;type=3#QuitButton" />
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/MainMenu.uss?fileID=7433441132597879392&amp;guid=11ac15a71fcec9a46a277054ddd917f6&amp;type=3#MainMenu" />
