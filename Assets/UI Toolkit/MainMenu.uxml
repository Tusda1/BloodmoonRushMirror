    <engine:Template name="StartButton" src="project://database/Assets/UI%20Toolkit/SpriteElements/StartButton.uxml?fileID=9197481963319205126&amp;guid=2ba961de4e3b9a24a9b8d8314a92882a&amp;type=3#StartButton" />
