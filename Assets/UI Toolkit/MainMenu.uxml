<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="SettingsMenu" src="project://database/Assets/UI%20Toolkit/SettingsMenu.uxml?fileID=9197481963319205126&amp;guid=774d38d636bfb324eab883249e6c0099&amp;type=3#SettingsMenu" />
    <Style src="project://database/Assets/UI%20Toolkit/Menu.uss?fileID=7433441132597879392&amp;guid=11ac15a71fcec9a46a277054ddd917f6&amp;type=3#Menu" />
    <engine:VisualElement style="flex-grow: 1;">
        <engine:Label text="Press Any Key" name="PressAnyKeyLabel" style="-unity-text-align: upper-center; font-size: 16px; color: rgb(255, 255, 255); top: 388px;" />
        <engine:VisualElement name="MainMenu" class="down" style="flex-grow: 1; transition-duration: 1s;">
            <engine:VisualElement name="MainMenuRoot" style="flex-grow: 1; flex-direction: row; justify-content: space-around; top: 157px;">
                <engine:Button text="Start" name="StartButton" />
                <engine:Button text="Settings" name="SettingsButton" />
                <engine:Button text="Quit" name="QuitButton" />
            </engine:VisualElement>
            <engine:VisualElement name="SettingsMenuRoot" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; translate: 100% 0;">
                <engine:Instance template="SettingsMenu" />
                <engine:Button text="Back" name="MenuButton" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
