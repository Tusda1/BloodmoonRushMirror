<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/GameOver.uss?fileID=7433441132597879392&amp;guid=bd8556074fa10ca4baed125957cf0cf7&amp;type=3#GameOver" />
    <engine:VisualElement style="flex-grow: 1;">
        <engine:VisualElement style="flex-grow: 1; flex-direction: column-reverse;">
            <engine:Label text="Thank YOU so much for playing our game! :3" style="position: absolute; top: 10px; left: 13px; font-size: 64px; color: rgb(255, 255, 255); white-space: normal; width: 601px; -unity-font-definition: resource(&apos;Fonts/UI&apos;);" />
            <engine:Button text="Back To Main Menu" name="BackToMainMenuButton" class="gameOverButton" style="width: 322px; position: relative; font-size: 32px; height: 38px; bottom: 5px; align-self: center; -unity-font-definition: resource(&apos;Fonts/UI&apos;);" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
