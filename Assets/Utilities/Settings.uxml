    <Label text="Settings" style="align-self: center; font-size: 83px; -unity-font-style: normal; -unity-text-align: upper-left; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/NPC%20_%20Ui.ttf?fileID=12800000&amp;guid=b9b48acb196babc4a9e6b515041cda24&amp;type=3#NPC _ Ui&quot;); margin-top: 150px; margin-bottom: 26px;" />
    <TabView name="TabbedView" style="height: 75%; align-self: center; align-items: center; width: 75%; -unity-font-definition: url(&quot;project://database/Packages/com.erlend-eiken-oppedal.debuglogger/Editor/home-video-font/HomeVideo-BLG6G.ttf?fileID=12800000&amp;guid=5f2ba05984567144fba2558348923b14&amp;type=3#HomeVideo-BLG6G&quot;);">
