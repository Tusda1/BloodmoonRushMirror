<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement data-source-type="DialogueCharacter, Assembly-CSharp" style="flex-direction: row; height: auto; width: 627px;">
        <engine:VisualElement style="background-image: url(&apos;project://database/Assets/Art/UI_concept.aseprite?fileID=-2030652020721891379&amp;guid=184d1c5d3645011498ec765efc0784d6&amp;type=3#UI_concept_0&apos;); -unity-background-scale-mode: scale-to-fit; width: 92px; height: 103px; max-height: 103px; min-height: 103px; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 0;">
            <engine:VisualElement style="flex-grow: 1; width: 74px; height: 74px; max-height: 75px; min-height: 75px; top: 8px; left: 9px; background-image: url(&quot;project://database/Assets/Art/UI_concept.aseprite?fileID=-2030652020721891379&amp;guid=184d1c5d3645011498ec765efc0784d6&amp;type=3#UI_concept_0&quot;);">
                <Bindings>
                    <engine:DataBinding property="style.backgroundImage" data-source-path="dialogueImage" binding-mode="ToTarget" />
                </Bindings>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement style="background-image: url(&quot;project://database/Assets/Art/UI_concept.aseprite?fileID=4492397765519729392&amp;guid=184d1c5d3645011498ec765efc0784d6&amp;type=3#UI_concept_1&quot;); width: 533px; height: 62px; max-height: 62px; min-height: 62px;">
            <engine:Label text="Example Display Text" style="width: 508px; left: 11px; top: 16px; height: 39px; position: relative; -unity-font-definition: url(&quot;project://database/Assets/Fonts/NPC%20_%20Ui.ttf?fileID=12800000&amp;guid=b9b48acb196babc4a9e6b515041cda24&amp;type=3#NPC _ Ui&quot;); font-size: 8px;">
                <Bindings>
                    <engine:DataBinding property="style.fontSize" data-source-path="textSize" binding-mode="ToTarget" />
                    <engine:DataBinding property="style.color" data-source-path="dialogueColor" binding-mode="ToTarget" />
                    <engine:DataBinding property="style.unityFontDefinition" data-source-path="dialogueFont" binding-mode="ToTarget" />
                </Bindings>
            </engine:Label>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
