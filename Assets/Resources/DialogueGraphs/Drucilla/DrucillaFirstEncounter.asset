      type: {class: 'BlackboardVariable`1[[System.String, mscorlib]]', ns: Unity.Behavior, asm: Unity.Behavior}
      data:
        GUID:
          m_Value0: 0
          m_Value1: 0
        Name: 
        m_Value: "To think you can defeat me? Fufufu~! Sweetie, you\u2019re like
