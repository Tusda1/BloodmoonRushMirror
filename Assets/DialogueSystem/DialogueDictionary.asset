%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc2c2f7ffb245e641b8a8104a6d7dc54, type: 3}
  m_Name: DialogueDictionary
  m_EditorClassIdentifier: 
  dialogueDictionary:
    _serializedList:
    - Key: David_Ellipsis
      Value:
        text: . . .
        character: {fileID: 11400000, guid: 206a9c7f94fa46a4bb93deab729f915c, type: 2}
        whereToPlaySFX: 4
        autoContinue: 0
        textSpeed: 4
        soundID: David_Ellipsis
        characterName: David
    - Key: David_Shocked
      Value:
        text: '!!!'
        character: {fileID: 11400000, guid: 206a9c7f94fa46a4bb93deab729f915c, type: 2}
        whereToPlaySFX: 1
        autoContinue: 0
        textSpeed: 2
        soundID: David_Shocked
        characterName: David
    - Key: Dracula_BeforeBossFight_01
      Value:
        text: You entertained Druscilla well enough, but you hurt her and I can not
          forgive that!
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_BeforeBossFight_02
      Value:
        text: And I see my good for nothing staff was not enough of a hinderance
          to your determination.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_BeforeBossFight_03
      Value:
        text: "So i guess \u2026 "
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_BeforeBossFight_04
      Value:
        text: "It\u2019s time for me to get my own hands dirty!"
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_DuringBossFight_01
      Value:
        text: Arrrg! I see you are tougher than I thought.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_DuringBossFight_02
      Value:
        text: For a mortal you have lasted for far too long.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_DuringBossFight_03
      Value:
        text: Time to bring out my secret weapon!
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_DuringBossFight_04
      Value:
        text: "It\u2019s time to\u2026"
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_DuringBossFight_05
      Value:
        text: work those glutes!
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_OpeningDialogue_01
      Value:
        text: Ah... What a predictable outcome. A mere human, brash, reckless and 
          utterly lacking in grace as usual. Smashing through my ancient, irreplaceable 
          castle walls with... this.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_OpeningDialogue_02
      Value:
        text: Well, since you seem so eager to part with your possessions... I shall
          take this.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_OpeningDialogue_03
      Value:
        text: Yes... a fitting compensation for the insult you have delivered upon
          my home.
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Dracula_OpeningDialogue_04
      Value:
        text: As for you, I would suggest you scram!
        character: {fileID: 11400000, guid: a54d4654070a69049a3e01a6c5e78d7f, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Dracula
        characterName: Dracula
    - Key: Drucilla_AfterBossFight_01
      Value:
        text: Wha- WHAT?! NO! No, no, this cant be happening!
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_AfterBossFight_02
      Value:
        text: "I do not lose! Do you have any idea who I am?! I am Drucilla! Daughter
          of Dracula! Heir to the night! Daddy\u2019s litttle prinsess!"
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_AfterBossFight_03
      Value:
        text: YOU! You cheated!
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_AfterBossFight_04
      Value:
        text: "That\u2019s the only explanation! Some Pathetic peasant like you could
          never defeat someone as flawless as me! UGH! This is so unfair!"
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_AfterBossFight_05
      Value:
        text: "Have your stupid little victory! But don\u2019t think for one second
          that this is over!"
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_AfterBossFight_06
      Value:
        text: "When I tell Father about this, you are so doomed. You\u2019ll be begging
          for mercy once he\u2019s through with you!"
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_BeforeBossFight_01
      Value:
        text: Oh? The peasant is alive. Well, not without taking some hits I see.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_BeforeBossFight_02
      Value:
        text: Do you truly believe you can get past me just because you have survived
          a few low lives?
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_BeforeBossFight_03
      Value:
        text: Ha! I do love a good joke. But, alas, all things must come to an end,
          including your delusions.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_BeforeBossFight_04
      Value:
        text: "Do try to entertain me, won\u2019t you?"
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_BeforeBossFight_05
      Value:
        text: Otherwise, this is going to be so unbearably dull.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_01
      Value:
        text: Is this what my father's castle has been reduced too? Filthy peasants
          intruding and tracking mud across the marble?
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: ???
    - Key: Drucilla_DrucillaIntroduction_02
      Value:
        text: Well, you clearly have no idea whose presence you've just barged into.
          Let me take some pity and educate you on the matter.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: ???
    - Key: Drucilla_DrucillaIntroduction_03
      Value:
        text: I am Drucilla, daughter of the almighty Dracula, heir to his eternal
          dominion, and most importantly-
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_04
      Value:
        text: Daddy's little princess!
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_05
      Value:
        text: This castle? Mine.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_06
      Value:
        text: The night itself? Mine.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_07
      Value:
        text: Your pathetic excuse for a fate? Oh, that, too, belongs to me.
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_08
      Value:
        text: And yet, you march in here like some bold little hero, thinking you
          stand a chance? Ohhh, that is just hilarious!
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_09
      Value:
        text: Even the rats in my father's dungeon have more refinement than you.
          Shall we see how you fair against them?
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Drucilla_DrucillaIntroduction_10
      Value:
        text: Buh-bye, peasant!
        character: {fileID: 11400000, guid: 7afd6b2200475f747aa660368f34970a, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Drucilla
        characterName: Drucilla
    - Key: Oswald_CastleMain_Checkpoint1_01
      Value:
        text: 
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint1_02
      Value:
        text: 
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_01
      Value:
        text: Ahh the memories, up ahead is the library.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_02
      Value:
        text: I used to read all the books available to me and nothing could stop
          me, I even made a little system of magical book platforms to help me manoeuvre
          around.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_03
      Value:
        text: "You\u2019ll probably have use of that!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_04
      Value:
        text: "There was this one book I\u2019ve been looking forward to reading
          once I get freed, maybe you could find it?"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_05
      Value:
        text: "No\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint2_06
      Value:
        text: Ok, well -
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint3_01
      Value:
        text: "I see you\u2019re doing good! But hanging up on me earlier was quite
          a rude thing to do. "
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint3_02
      Value:
        text: "Anyway I see you\u2019ve reached Drucilla\u2019s wing of the castle,"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint3_03
      Value:
        text: "If the pink wasn\u2019t enough of an indicator to that."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Checkpoint4_01
      Value:
        text: 
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Intro_01
      Value:
        text: Wowza! That was amazing that thing has been a thorn in my side when
          it comes to communication!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Intro_02
      Value:
        text: "Good job on taking out that Anti Union Bot, maybe it\u2019ll be a
          better place around here since it\u2019s gone?"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Intro_03
      Value:
        text: "Anyway\u2026 welcome back to the main floor."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Intro_04
      Value:
        text: "Hmm\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_CastleMain_Intro_05
      Value:
        text: "Don\u2019t think \u201Cdon\u2019t get steamed\u201D is gonna work
          anymore\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_EntranceHall_Checkpoint1_01
      Value:
        text: You're on fire, kid! Look at those moves! Oh, and remember those goons
          I mentioned?
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_EntranceHall_Checkpoint1_02
      Value:
        text: Yeah, they're just up ahead, so keep your eyes peeled and your wits
          sharper than a vampire's fangs!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_EntranceHall_Checkpoint2_01
      Value:
        text: Ya-ho! You're tearing through this place like a kid in a candy store!
          Oh, and guess what?
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_EntranceHall_Checkpoint2_02
      Value:
        text: That weapon of yours yeah? Well I gave it a little tweak. Now every
          time you pull off something flashy, you'll get a sweet boost!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_EntranceHall_Checkpoint2_03
      Value:
        text: Go on, try it out up ahead. Show em what you've got, champ!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_Falling_01
      Value:
        text: "SooooOooOOoOooooooOOOO\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_Falling_02
      Value:
        text: "You just meet Drucilla, that\u2019s the big mans daughter. She\u2019s
          the princess of this castle if you didn\u2019t pick that up."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_Falling_03
      Value:
        text: "\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_Falling_04
      Value:
        text: "Well looks like you\u2019re ready for whats ahead! Now off you go
          and beat-\u2019em. Like a boss!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_Falling_05
      Value:
        text: Trying to find a good catchphrase so hope you liked that one.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_01
      Value:
        text: Bzzz... zzz.. Hel...btzzz...oOo...bzz
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: ???
    - Key: Oswald_OswaldIntroduction_02
      Value:
        text: HELLO! Hiiii! Great this works! I'm Oswald the Befuddled.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_03
      Value:
        text: Wizard extraordinaire, castle prisoner, and now your official guide
          to not dying in this madhouse.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_04
      Value:
        text: That flashy thing Dracula stole? Your car- You want that back right?
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_05
      Value:
        text: 'Good news: I can help! Bad news: this place is crawling with traps
          and goons.'
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_06
      Value:
        text: More good news! I've scattered some magical tips around the castle.
          Call it... wizard graffiti, if you will. Keep your eyes peeled! And don't
          worry, I'll check in from time to time.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_OswaldIntroduction_07
      Value:
        text: Off you go kiddo!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint1_01
      Value:
        text: "You\u2019re still alive! Wonderfull!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint1_02
      Value:
        text: "So fun fact these are the machines that makes the castle move around,
          it used to be my job but alas i could not bear the guilt of following Dracula\u2019s
          scheme."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint1_03
      Value:
        text: So I rebelled and well you see where that got me.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint1_04
      Value:
        text: Trapped!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint1_05
      Value:
        text: "Anyway watch out and don\u2019t get steamed or crushed!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint2_01
      Value:
        text: Getting close to the exit now bud!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint2_02
      Value:
        text: Just some sharp hinderances ahead but you got this!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint2_03
      Value:
        text: "Don\u2019t get steamed! That\u2019ll burn for sure!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Checkpoint3_01
      Value:
        text: bzzzzzzz* zzz **** bzz*
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_01
      Value:
        text: " So the \u201Clike a boss\u201D is getting old. I think I have to
          try something new."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_02
      Value:
        text: 'Like- '
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_03
      Value:
        text: "Don\u2019t get steamed!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_04
      Value:
        text: "Ye that\u2019ll work!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_05
      Value:
        text: "Talking of steam. You better watch where you\u2019re going since it\u2019s
          the boilers that\u2019s ahead."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_06
      Value:
        text: "Lots of dangerous stuff all around\u2026"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheBoiler_Intro_07
      Value:
        text: "Good luck, and don\u2019t get steamed!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint1_01
      Value:
        text: "Sooo it looks like you\u2019re quite the way bellow there bud, a couple
          levels bellow the main floors at least."
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint1_02
      Value:
        text: The dungeon by the looks of it, well you got this champ!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint1_03
      Value:
        text: "Anything that\u2019s in your way you\u2019ll beat them, like a boss!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint2_01
      Value:
        text: Looks like the whole place is in lock down, so if you wanna continue
          forward you gotta find those keys!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint2_02
      Value:
        text: "But you\u2019re smart you\u2019ll find them in no time!"
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Checkpoint2_03
      Value:
        text: Like a Boss!!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Intro_01
      Value:
        text: Oh... and watch out for that landing.
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
    - Key: Oswald_TheDungeons_Intro_02
      Value:
        text: Well you got this, use what you see to your advantage, like a boss!
        character: {fileID: 11400000, guid: 6090bbc712dfde848b703d0993ec28a3, type: 2}
        whereToPlaySFX: 2
        autoContinue: 0
        textSpeed: 32
        soundID: Talk_Oswald
        characterName: Oswald
